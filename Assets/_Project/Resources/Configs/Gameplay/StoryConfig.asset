%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c67dbd46ddd9f4e419b9de5911d46931, type: 3}
  m_Name: StoryConfig
  m_EditorClassIdentifier: Assembly-CSharp::_Project.Develop.Runtime.Configs.Gameplay.StoryConfig
  Monologues:
  - Id: wake_up
    Lines:
    - Text: "...\u0416\u0438\u0432. \u041F\u043E\u0441\u043B\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
        \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u2014 \u0438 \u0436\u0438\u0432.
        \u041A\u0430\u043A \u0436\u0435 \u043C\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E."
      Voice: {fileID: 0}
    - Text: "\u0417\u0435\u043C\u043B\u0438 \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
        \u043D\u0435\u0442. \u0417\u043D\u0430\u0447\u0438\u0442, \u043C\u044B \u0443\u043F\u0430\u043B\u0438
        \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u041B\u0443\u043D\u044B."
      Voice: {fileID: 0}
    - Text: "\u0427\u0442\u043E\u0431\u044B \u043D\u0430 \u0417\u0435\u043C\u043B\u0435
        \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438, \u0447\u0442\u043E \u044F
        \u0432\u044B\u0436\u0438\u043B, \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0439\u0442\u0438
        \u0434\u043E \u043B\u0438\u043D\u0438\u0438, \u043E\u0442\u043A\u0443\u0434\u0430
        \u0435\u0451 \u0432\u0438\u0434\u043D\u043E."
      Voice: {fileID: 0}
    - Text: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0435\u0449\u0438.
        \u0412\u0441\u0451, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
        \u0434\u043E\u0439\u0442\u0438, \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
        \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043E \u0433\u0434\u0435-\u0442\u043E
        \u0437\u0434\u0435\u0441\u044C."
      Voice: {fileID: 0}
  - Id: item_food
    Lines:
    - Text: "\u041A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \u0441 \u0435\u0434\u043E\u0439.
        \u0411\u0435\u0437 \u043D\u0435\u0451 \u0434\u043E\u043B\u0433\u0438\u0435
        \u043F\u0440\u0438\u0432\u0430\u043B\u044B \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C.
        \u0417\u0430\u0442\u043E \u043E\u043D \u0442\u044F\u0436\u0451\u043B\u044B\u0439:
        \u0447\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u0435\u0434\u044B,
        \u0442\u0435\u043C \u043B\u0435\u0433\u0447\u0435 \u0438\u0434\u0442\u0438."
      Voice: {fileID: 0}
  - Id: item_tent
    Lines:
    - Text: "\u0413\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0430\u044F \u043F\u0430\u043B\u0430\u0442\u043A\u0430!
        \u0412\u044B\u0434\u0435\u0440\u0436\u0438\u0442 \u0438 \u0436\u0430\u0440\u0443,
        \u0438 \u0445\u043E\u043B\u043E\u0434. \u0411\u0435\u0437 \u043D\u0435\u0451
        \u043D\u0430 \u041B\u0443\u043D\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C
        \u043D\u0438 \u0434\u043D\u044F, \u043D\u0438 \u043D\u043E\u0447\u0438."
      Voice: {fileID: 0}
  - Id: item_oxygen
    Lines:
    - Text: "\u041A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u043D\u044B\u0435 \u0431\u0430\u043B\u043B\u043E\u043D\u044B.
        \u0412\u043E\u0442 \u0447\u0442\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
        \u0434\u0435\u043B\u0435 \u043E\u0442\u043C\u0435\u0440\u044F\u0435\u0442
        \u043C\u043E\u0451 \u0432\u0440\u0435\u043C\u044F."
      Voice: {fileID: 0}
  - Id: item_device
    Lines:
    - Text: "\u041C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
        \u0443\u0446\u0435\u043B\u0435\u043B\u043E. \u041C\u044B \u0432\u0435\u0437\u043B\u0438
        \u0435\u0433\u043E \u043D\u0430 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F,
        \u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u043E\u043D\u043E
        \u043C\u043D\u0435 \u0441\u0430\u043C\u043E\u043C\u0443."
      Voice: {fileID: 0}
  - Id: need_items
    Lines:
    - Text: "\u0420\u0430\u043D\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u044C.
        \u0411\u0435\u0437 \u0432\u0435\u0449\u0435\u0439 \u044F \u0434\u0430\u043B\u0435\u043A\u043E
        \u043D\u0435 \u0443\u0439\u0434\u0443."
      Voice: {fileID: 0}
  - Id: all_items
    Lines:
    - Text: "\u042D\u0442\u043E \u0432\u0441\u0451, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E
        \u0443\u043D\u0435\u0441\u0442\u0438. \u0422\u044E\u043A \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
        \u0441 \u043C\u0435\u043D\u044F, \u043D\u043E \u043F\u0440\u0438 \u043B\u0443\u043D\u043D\u043E\u0439
        \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u044F \u0441\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C."
      Voice: {fileID: 0}
    - Text: "\u0422\u0430\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0430\u043B\u0430,
        \u043F\u0443\u0442\u0438 \u043D\u0435\u0442. \u0417\u043D\u0430\u0447\u0438\u0442,
        \u0438\u0434\u0442\u0438 \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
      Voice: {fileID: 0}
  - Id: cloud_first
    Lines:
    - Text: "\u041E\u0431\u043B\u0430\u043A\u043E \u043D\u0430\u043C\u0430\u0433\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0445
        \u0447\u0430\u0441\u0442\u0438\u0446. \u0415\u0433\u043E \u043C\u043E\u0436\u043D\u043E
        \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
        \u041C\u0423."
      Voice: {fileID: 0}
    - Text: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u043E \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044E
        \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0438\u0437 \u043D\u0430\u043C\u0430\u0433\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439
        \u043F\u044B\u043B\u0438 \u0431\u044B\u043B\u043E \u043D\u0430\u0439\u0434\u0435\u043D\u043E
        \u043F\u0430\u0440\u0443 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
        \u043C\u043E\u0438\u043C \u0443\u0447\u0451\u043D\u044B\u043C. \u042F \u0438
        \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B,
        \u0447\u0442\u043E \u043E\u043D\u043E \u043C\u043D\u0435 \u0442\u0430\u043A
        \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
      Voice: {fileID: 0}
  - Id: device_works
    Lines:
    - Text: "\u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442! \u042D\u043D\u0435\u0440\u0433\u0438\u044F
        \u0438\u0434\u0451\u0442 \u0432 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044C."
      Voice: {fileID: 0}
  - Id: energy_to_oxygen
    Lines:
    - Text: "\u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
        \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u0435 \u041C\u0423,
        \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
        \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
        \u043D\u0443\u0436\u043D\u0430 \u043F\u0430\u043B\u0430\u0442\u043A\u0430:
        \u043F\u043E\u043A\u0430 \u044F \u043E\u0442\u0434\u044B\u0445\u0430\u044E,
        \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0432\u0441\u0451
        \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
      Voice: {fileID: 0}
  - Id: heat_soon
    Lines:
    - Text: "\u0421\u043E\u043B\u043D\u0446\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
        \u0432\u0441\u0451 \u0432\u044B\u0448\u0435. \u0421\u043A\u043E\u0440\u043E
        \u0433\u0440\u0443\u043D\u0442 \u0440\u0430\u0441\u043A\u0430\u043B\u0438\u0442\u0441\u044F.
        \u041F\u043E\u0440\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0430\u043B\u0430\u0442\u043A\u0443
        \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0436\u0430\u0440\u0443."
      Voice: {fileID: 0}
  - Id: cold_soon
    Lines:
    - Text: "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435.
        \u041F\u043E\u0440\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0430\u043B\u0430\u0442\u043A\u0443,
        \u043D\u043E\u0447\u044C\u044E \u0441\u043D\u0430\u0440\u0443\u0436\u0438
        \u043D\u0435 \u0432\u044B\u0436\u0438\u0442\u044C."
      Voice: {fileID: 0}
  - Id: heat_started
    Lines:
    - Text: "\u0416\u0430\u0440\u0430! \u0421\u043A\u0430\u0444\u0430\u043D\u0434\u0440
        \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442.
        \u041D\u0443\u0436\u043D\u043E \u0432 \u043F\u0430\u043B\u0430\u0442\u043A\u0443!"
      Voice: {fileID: 0}
  - Id: cold_started
    Lines:
    - Text: "\u041C\u043E\u0440\u043E\u0437 \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u0435\u0442
        \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440.
        \u0412 \u043F\u0430\u043B\u0430\u0442\u043A\u0443, \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E!"
      Voice: {fileID: 0}
  - Id: tent_placed
    Lines:
    - Text: "\u041F\u0430\u043B\u0430\u0442\u043A\u0430 \u0441\u0442\u043E\u0438\u0442.
        \u041C\u043E\u0436\u043D\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0432\u043D\u0443\u0442\u0440\u044C \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C.
        \u041F\u0435\u0440\u0435\u0434 \u0443\u0445\u043E\u0434\u043E\u043C \u0435\u0451
        \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C."
      Voice: {fileID: 0}
  - Id: after_first_rest
    Lines:
    - Text: "\u041F\u0440\u043E\u043D\u0435\u0441\u043B\u043E. \u041D\u043E \u0437\u0430\u043F\u0430\u0441
        \u0435\u0434\u044B \u0442\u0430\u0435\u0442 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C
        \u043F\u0440\u0438\u0432\u0430\u043B\u043E\u043C."
      Voice: {fileID: 0}
    - Text: "\u041F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
        \u0435\u0449\u0451 \u0434\u043E \u043B\u0438\u043D\u0438\u0438 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
        \u044F \u043D\u0435 \u0437\u043D\u0430\u044E."
      Voice: {fileID: 0}
  - Id: ledge_up_first
    Lines:
    - Text: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u044B\u0441\u043E\u043A\u043E.
        \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043A\u0438\u043D\u0443
        \u0442\u044E\u043A \u043D\u0430\u0432\u0435\u0440\u0445, \u0430 \u043F\u043E\u0442\u043E\u043C
        \u0437\u0430\u043B\u0435\u0437\u0443 \u0441\u0430\u043C."
      Voice: {fileID: 0}
  - Id: ledge_down_first
    Lines:
    - Text: "\u041E\u0431\u0440\u044B\u0432. \u041F\u0440\u044B\u0433\u0430\u0442\u044C
        \u0441 \u0442\u044E\u043A\u043E\u043C \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
        \u2014 \u043F\u043B\u043E\u0445\u0430\u044F \u0438\u0434\u0435\u044F. \u0421\u0431\u0440\u043E\u0448\u0443
        \u0435\u0433\u043E \u0432\u043D\u0438\u0437 \u0438 \u0441\u043F\u0443\u0449\u0443\u0441\u044C
        \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043D\u0435\u0433\u043E."
      Voice: {fileID: 0}
  - Id: hard_landing
    Lines:
    - Text: "\u041E\u0445... \u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
        \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u044E\u043A. \u0421\u043A\u0430\u0444\u0430\u043D\u0434\u0440
        \u0442\u0440\u0430\u0432\u0438\u0442 \u0432\u043E\u0437\u0434\u0443\u0445."
      Voice: {fileID: 0}
  - Id: warm_dust_first
    Lines:
    - Text: "\u041F\u044B\u043B\u044C \u2014 \u044D\u0442\u043E \u0433\u0440\u0443\u043D\u0442,
        \u043E\u043D \u0442\u0451\u043F\u043B\u044B\u0439. \u0415\u0441\u043B\u0438
        \u044F \u043F\u043E\u043B\u043E\u0436\u0443 \u0435\u0433\u043E \u0432 \u043F\u0430\u043B\u0430\u0442\u043A\u0443,
        \u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0431\u0443\u0434\u0435\u0442
        \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0442\u0435\u043F\u043B\u0430."
      Voice: {fileID: 0}
    - Text: "\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043D\u0430\u0434\u043E,
        \u043F\u043E\u043A\u0430 \u043D\u0435 \u043E\u0441\u0442\u044B\u043B. \u0418\u043D\u0430\u0447\u0435
        \u0432 \u0445\u043E\u043B\u043E\u0434 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
        \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0434\u0432\u043E\u0435
        \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0434\u044B."
      Voice: {fileID: 0}
  - Id: warm_dust_used
    Lines:
    - Text: "\u041F\u044B\u043B\u044C \u0432\u0441\u0451 \u0435\u0449\u0451 \u0433\u0440\u0435\u0435\u0442.
        \u0425\u043E\u043B\u043E\u0434 \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C
        \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435."
      Voice: {fileID: 0}
  - Id: cold_without_dust
    Lines:
    - Text: "\u041A\u0430\u043A\u043E\u0439 \u0445\u043E\u043B\u043E\u0434. \u0427\u0442\u043E\u0431\u044B
        \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F, \u0443\u0448\u043B\u043E
        \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0434\u044B.
        \u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
        \u0442\u0451\u043F\u043B\u043E\u0439 \u043F\u044B\u043B\u0438."
      Voice: {fileID: 0}
  - Id: tunnel_mouth
    Lines:
    - Text: "\u0413\u043E\u0440\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u043B\u0430
        \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C, \u043D\u043E \u0432 \u043D\u0435\u0439
        \u0435\u0441\u0442\u044C \u0442\u043E\u043D\u043D\u0435\u043B\u044C. \u0427\u0435\u0440\u0435\u0437
        \u043D\u0435\u0433\u043E \u0438 \u043F\u043E\u0439\u0434\u0443."
      Voice: {fileID: 0}
    - Text: "\u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u043A\u0430\u043B\u0430
        \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u0451
        \u0442\u0435\u043F\u043B\u043E. \u0412\u0445\u043E\u0434\u0438\u0442\u044C
        \u043C\u043E\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0432
        \u0441\u0430\u043C\u0443\u044E \u0436\u0430\u0440\u0443, \u0438\u043D\u0430\u0447\u0435
        \u0437\u0430\u043C\u0451\u0440\u0437\u043D\u0443."
      Voice: {fileID: 0}
  - Id: tunnel_inside
    Lines:
    - Text: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u043B\u043D\u043E \u043D\u0430\u043C\u0430\u0433\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439
        \u043F\u044B\u043B\u0438. \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
        \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0438\u0442\u044C \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u0435
        \u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u0434\u043E \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0430,
        \u0438 \u043E\u0431\u0437\u043E\u0440 \u043F\u043E\u0447\u0442\u0438 \u043F\u0440\u043E\u043F\u0430\u043B."
      Voice: {fileID: 0}
  - Id: tunnel_exit
    Lines:
    - Text: "\u0421\u0432\u0435\u0442! \u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
        \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0434\u043D\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442."
      Voice: {fileID: 0}
  - Id: morale_good
    Lines:
    - Text: "\u041E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435. \u041A\u0430\u043C\u043D\u0438,
        \u043F\u044B\u043B\u044C, \u0442\u0438\u0448\u0438\u043D\u0430. \u041E\u0447\u0435\u043D\u044C
        \u0445\u043E\u0447\u0443 \u0434\u043E\u043C\u043E\u0439. \u041D\u043E\u0433\u0438
        \u0443\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A\u0438\u0435 \u043B\u0451\u0433\u043A\u0438\u0435."
      Voice: {fileID: 0}
  - Id: morale_bad
    Lines:
    - Text: "\u0412\u0441\u0451 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0435,
        \u0441\u0438\u043B \u043D\u0435\u0442. \u041D\u0430\u0434\u043E \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C
        \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u0430\u0437, \u0438\u043D\u0430\u0447\u0435
        \u044F \u0435\u0434\u0432\u0430 \u043F\u043B\u0435\u0442\u0443\u0441\u044C."
      Voice: {fileID: 0}
  - Id: low_oxygen
    Lines:
    - Text: "\u041A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430 \u043C\u0435\u043D\u044C\u0448\u0435
        \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438. \u041D\u0443\u0436\u043D\u043E
        \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u043B\u0430\u043A\u0430
        \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C, \u043F\u043E\u043A\u0430
        \u0435\u0441\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u0438\u044F."
      Voice: {fileID: 0}
  - Id: low_food
    Lines:
    - Text: "\u0415\u0434\u044B \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
        \u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0432\u0430\u043B,
        \u0438 \u0432\u0441\u0451."
      Voice: {fileID: 0}
  - Id: new_place_1
    Lines:
    - Text: "\u0417\u0434\u0435\u0441\u044C \u0445\u043E\u0442\u044F \u0431\u044B
        \u0432\u0438\u0434 \u0434\u0440\u0443\u0433\u043E\u0439. \u0423\u0436\u0435
        \u0447\u0442\u043E-\u0442\u043E."
      Voice: {fileID: 0}
  - Id: new_place_2
    Lines:
    - Text: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0445\u0440\u0435\u0431\u0435\u0442
        \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u042F \u0438\u0434\u0443
        \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
        \u044F \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E."
      Voice: {fileID: 0}
  - Id: final_climb
    Lines:
    - Text: "\u0421\u043A\u043B\u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u043A\u0440\u0443\u0447\u0435. \u0415\u0441\u043B\u0438 \u0433\u0434\u0435-\u0442\u043E
        \u0438 \u0432\u0438\u0434\u043D\u043E \u0417\u0435\u043C\u043B\u044E, \u0442\u043E
        \u0442\u0430\u043C, \u043D\u0430\u0432\u0435\u0440\u0445\u0443."
      Voice: {fileID: 0}
  - Id: earth_seen
    Lines:
    - Text: "\u0412\u043E\u0442 \u043E\u043D\u0430... \u0417\u0435\u043C\u043B\u044F!"
      Voice: {fileID: 0}
    - Text: "\u042F \u0432\u0438\u0436\u0443 \u0435\u0451. \u0417\u043D\u0430\u0447\u0438\u0442,
        \u0442\u0435\u043F\u0435\u0440\u044C \u0438 \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
        \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043C\u0435\u043D\u044F."
      Voice: {fileID: 0}
    - Text: "\u0412\u043A\u043B\u044E\u0447\u0430\u044E \u043C\u0430\u044F\u043A.
        \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u043E\u043B\u044C\u043A\u043E
        \u0436\u0434\u0430\u0442\u044C."
      Voice: {fileID: 0}
  - Id: ambient_1
    Lines:
    - Text: "\u0414\u043E\u0447\u043A\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
        \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438 \u0435\u0439 \u043B\u0443\u043D\u043D\u044B\u0439
        \u043A\u0430\u043C\u0435\u043D\u044C. \u0421\u043C\u0435\u0448\u043D\u043E:
        \u0442\u0435\u043F\u0435\u0440\u044C \u0438\u0445 \u0443 \u043C\u0435\u043D\u044F
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0433\u043E\u0434\u043D\u043E."
      Voice: {fileID: 0}
  - Id: ambient_2
    Lines:
    - Text: "\u041A\u043E\u0433\u0434\u0430 \u044F \u0443\u043B\u0435\u0442\u0430\u043B,
        \u0436\u0435\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430: \u0442\u043E\u043B\u044C\u043A\u043E
        \u043D\u0435 \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u0443\u0439.
        \u0421\u0442\u0430\u0440\u0430\u044E\u0441\u044C, \u0447\u0435\u0441\u0442\u043D\u043E."
      Voice: {fileID: 0}
  - Id: ambient_3
    Lines:
    - Text: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
        \u044F \u0438\u0437\u0443\u0447\u0430\u043B \u041B\u0443\u043D\u0443 \u043F\u043E
        \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
        \u0432\u043E\u0442 \u0438\u0437\u0443\u0447\u0430\u044E \u043D\u043E\u0433\u0430\u043C\u0438."
      Voice: {fileID: 0}
  - Id: ambient_4
    Lines:
    - Text: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0441\u044B\u043D
        \u0443\u0436\u0435 \u0441\u0434\u0430\u043B \u0441\u0432\u043E\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D?
        \u041E\u0431\u0435\u0449\u0430\u043B \u0435\u043C\u0443 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C
        \u0432 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C."
      Voice: {fileID: 0}
  - Id: ambient_5
    Lines:
    - Text: "\u041D\u0430 \u0417\u0435\u043C\u043B\u0435 \u044F \u0440\u0443\u0433\u0430\u043B
        \u0434\u043E\u0436\u0434\u0438. \u0421\u0435\u0439\u0447\u0430\u0441 \u043E\u0442\u0434\u0430\u043B
        \u0431\u044B \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430
        \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043B\u0438\u0432\u0435\u043D\u044C.
        \u041B\u0430\u0434\u043D\u043E, \u043D\u0435 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443."
      Voice: {fileID: 0}
  - Id: ambient_6
    Lines:
    - Text: "\u041C\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
        \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \u043D\u0430\u0443\u043A\u0430
        \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u043E\u0448\u0438\u0431\u0430\u0435\u0448\u044C\u0441\u044F,
        \u043D\u043E \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0448\u044C.
        \u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044E."
      Voice: {fileID: 0}
  - Id: ambient_7
    Lines:
    - Text: "\u0420\u0430\u0434\u0438\u0430\u0442\u043E\u0440\u044B \u0437\u0430\u0431\u0438\u043B\u0430
        \u043E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u044B\u043B\u044C. \u0421\u0442\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432, \u0430 \u043D\u0430\u0441
        \u0443\u0440\u043E\u043D\u0438\u043B\u0430 \u043F\u044B\u043B\u044C."
      Voice: {fileID: 0}
  - Id: ambient_8
    Lines:
    - Text: "\u041C\u0430\u043C\u0430 \u0434\u0443\u043C\u0430\u0435\u0442, \u0447\u0442\u043E
        \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0433\u0434\u0435-\u0442\u043E
        \u0432 \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0435, \u0441 \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C\u0438.
        \u041F\u0443\u0441\u0442\u044C \u043F\u043E\u043A\u0430 \u0442\u0430\u043A
        \u0438 \u0431\u0443\u0434\u0435\u0442."
      Voice: {fileID: 0}
  - Id: ambient_9
    Lines:
    - Text: "\u041F\u043E \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u044F\u043C
        \u043C\u044B \u0432\u0441\u0435\u0439 \u0441\u0435\u043C\u044C\u0451\u0439
        \u043F\u0435\u043A\u043B\u0438 \u0431\u043B\u0438\u043D\u044B. \u041F\u0435\u0440\u0432\u044B\u0439
        \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0434\u0433\u043E\u0440\u0430\u043B.
        \u0412\u0441\u0435\u0433\u0434\u0430 \u0441\u044A\u0435\u0434\u0430\u043B
        \u0435\u0433\u043E \u044F."
      Voice: {fileID: 0}
  - Id: ambient_10
    Lines:
    - Text: "\u0422\u0438\u0448\u0438\u043D\u0430 \u0437\u0434\u0435\u0441\u044C
        \u0442\u0430\u043A\u0430\u044F, \u0447\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E
        \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435.
        \u041E\u043D\u043E, \u043A\u0441\u0442\u0430\u0442\u0438, \u043F\u043E\u043A\u0430
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
      Voice: {fileID: 0}
  - Id: ambient_11
    Lines:
    - Text: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0443\u0441\u044C,
        \u043F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C \u0432\u044B\u0439\u0434\u0443
        \u0432 \u0441\u0430\u0434 \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u043E\u044E.
        \u0411\u0435\u0437 \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0430."
      Voice: {fileID: 0}
  - Id: ambient_12
    Lines:
    - Text: "\u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043D\u0430\u0448\u0438\u0445
        \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442
        \u043C\u0430\u044F\u043A. \u041E\u043D\u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u0435
        \u0440\u0435\u0431\u044F\u0442\u0430. \u041E\u043D\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0443\u0442
        \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
      Voice: {fileID: 0}
  - Id: ambient_13
    Lines:
    - Text: "\u041D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0430\u0441
        \u0443\u0436\u0435, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438
        \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u043C\u0438. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
        \u0434\u043E\u043C\u0430 \u0438\u043C \u043F\u043E\u043A\u0430 \u043D\u0435
        \u0441\u043A\u0430\u0437\u0430\u043B\u0438."
      Voice: {fileID: 0}
  - Id: ambient_14
    Lines:
    - Text: "\u042F \u0432\u0435\u0434\u044C \u0441\u0430\u043C \u0432\u044B\u0431\u0440\u0430\u043B
        \u044D\u0442\u0443 \u0440\u0430\u0431\u043E\u0442\u0443. \u0418 \u0441\u043D\u043E\u0432\u0430
        \u0431\u044B \u0432\u044B\u0431\u0440\u0430\u043B. \u041D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430,
        \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u043F\u043E\u043E\u0431\u0435\u0434\u0430\u043B
        \u0431\u044B."
      Voice: {fileID: 0}
  AmbientMonologues:
  - ambient_1
  - ambient_2
  - ambient_3
  - ambient_4
  - ambient_5
  - ambient_6
  - ambient_7

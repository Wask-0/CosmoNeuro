  Comics:
  - Id: 0
    Panels:
    - Image: {fileID: 21300000, guid: 82dbe7ef6526e6a42a98b0540b9b394e, type: 3}
      Caption: "\u041B\u0443\u043D\u043D\u0430\u044F \u0431\u0430\u0437\u0430, \u043D\u043E\u044F\u0431\u0440\u044C
        2036 \u0433\u043E\u0434\u0430. \u041A\u043E\u0440\u0430\u0431\u043B\u044C
        \u0441 \u0443\u0447\u0451\u043D\u044B\u043C \u043D\u0430 \u0431\u043E\u0440\u0442\u0443
        \u0441\u0442\u0430\u0440\u0442\u0443\u0435\u0442 \u0441 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
        \u041B\u0443\u043D\u044B."
    - Image: {fileID: 21300000, guid: b89c4718e3dfad5478251f5737b9b82e, type: 3}
      Caption: "\u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u043F\u044B\u043B\u044C \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442
        \u0440\u0430\u0434\u0438\u0430\u0442\u043E\u0440\u044B. \u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438
        \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430\u044E\u0442\u0441\u044F."
    - Image: {fileID: 21300000, guid: 955e08ff326f17547a1c99c699925b09, type: 3}
      Caption: "\u041A\u043E\u0440\u0430\u0431\u043B\u044C \u0442\u0435\u0440\u044F\u0435\u0442
        \u0442\u044F\u0433\u0443 \u0438 \u043F\u0430\u0434\u0430\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
        \u043D\u0430 \u041B\u0443\u043D\u0443."
    - Image: {fileID: 21300000, guid: f629e9e9e7ce4134f9a482fe3b7bef2d, type: 3}
      Caption: "\u041C\u0435\u0441\u0442\u043E \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u044F
        \u2014 \u043E\u0431\u0440\u0430\u0442\u043D\u0430\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430,
        \u0441\u043E\u0432\u0441\u0435\u043C \u0440\u044F\u0434\u043E\u043C \u0441
        \u043B\u0438\u043D\u0438\u0435\u0439 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438.
        \u041D\u043E \u0441 \u0417\u0435\u043C\u043B\u0438 \u0435\u0433\u043E \u043D\u0435
        \u0432\u0438\u0434\u043D\u043E."
  - Id: 1
    Panels:
    - Image: {fileID: 21300000, guid: 8de43a431a079904ea81c921ea35e58e, type: 3}
      Caption: "\u0414\u043E\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C \u0434\u043E
        \u0433\u0440\u0435\u0431\u043D\u044F, \u0443\u0447\u0451\u043D\u044B\u0439
        \u0432\u0438\u0434\u0438\u0442 \u0417\u0435\u043C\u043B\u044E \u0438 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
        \u043C\u0430\u044F\u043A."
    - Image: {fileID: 21300000, guid: 59c8e0d219e557b40933b9eea0775e0a, type: 3}
      Caption: "\u041D\u0430 \u0417\u0435\u043C\u043B\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442
        \u0441\u0438\u0433\u043D\u0430\u043B: \u043D\u0430 \u041B\u0443\u043D\u0435
        \u043A\u0442\u043E-\u0442\u043E \u0432\u044B\u0436\u0438\u043B!"
    - Image: {fileID: 21300000, guid: 444b4042f7102fc499eb7cd2a863482f, type: 3}
      Caption: "\u0417\u0430 \u043D\u0438\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442
        \u043A\u043E\u0440\u0430\u0431\u043B\u044C."
    - Image: {fileID: 21300000, guid: ae7a94dd39fe15040bfa4204aac95b55, type: 3}
      Caption: "\u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C, \u043E\u043D
        \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u0430\u043C.
        \xAB\u041A\u0430\u043A \u0432\u044B \u0432\u044B\u0436\u0438\u043B\u0438?\xBB
        \u2014 \xAB\u0428\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C\xBB."
